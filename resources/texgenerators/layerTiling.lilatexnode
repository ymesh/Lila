{
  "format": "lilatexnode",
  "version": 1,
  "type": "layerTiling",
  "label": "Layer Tiling",
  "category": "Layer",
  "doc": "Repeats a layer's content: tiles across the texture, turned around the centre (degrees) and shifted (in tiles).",
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0,
        0,
        0,
        1
      ]
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "tiles",
      "type": "float",
      "default": 1.0,
      "min": 0.001,
      "softMin": 0.25,
      "softMax": 16
    },
    {
      "id": "rotation",
      "type": "float",
      "default": 0.0,
      "softMin": -180,
      "softMax": 180
    },
    {
      "id": "offsetX",
      "type": "float",
      "default": 0.0,
      "softMin": 0,
      "softMax": 1
    },
    {
      "id": "offsetY",
      "type": "float",
      "default": 0.0,
      "softMin": 0,
      "softMax": 1
    }
  ],
  "cost": 1,
  "body": {
    "out": "float a = radians(p.rotation);\nfloat2 c = uv - 0.5;\nfloat2 r = float2(c.x * cos(a) - c.y * sin(a), c.x * sin(a) + c.y * cos(a));\nreturn input.sample(frac(r * p.tiles + 0.5 + float2(p.offsetX, p.offsetY)));"
  }
}
