{
  "format": "lilabrush",
  "version": 1,
  "name": "Double Stitch Line",
  "category": "Stitches",
  "doc": "Two parallel stitch rows.",
  "brush": {
    "falloff": "constant",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 1.8,
    "pressureSize": false,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": true,
    "roundness": 1.0,
    "alpha": "alpha://lila/fabric/double stitches.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
