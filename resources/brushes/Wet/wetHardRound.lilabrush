{
  "format": "lilabrush",
  "version": 1,
  "name": "Wet Hard Round",
  "category": "Wet",
  "doc": "Hard-edged transparent layers that build up.",
  "brush": {
    "falloff": "sharp",
    "strength": 1.0,
    "flow": 0.35,
    "spacing": 0.05,
    "pressureSize": false,
    "pressureOpacity": true,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
