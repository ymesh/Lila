{
  "format": "lilabrush",
  "version": 1,
  "name": "Chisel Marker",
  "category": "Wet",
  "doc": "A chisel nib at a fixed angle.",
  "brush": {
    "falloff": "constant",
    "strength": 1.0,
    "flow": 0.6,
    "spacing": 0.04,
    "pressureSize": false,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 30.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "alpha://lila/brush tips/chisel marker.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
