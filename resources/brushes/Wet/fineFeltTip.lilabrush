{
  "format": "lilabrush",
  "version": 1,
  "name": "Fine Felt Tip",
  "category": "Wet",
  "doc": "A thin, even felt-tip line.",
  "brush": {
    "falloff": "constant",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.1,
    "pressureSize": false,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "alpha://lila/brush tips/felt tip.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0,
    "radius": 4.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
