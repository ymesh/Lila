{
  "format": "lilabrush",
  "version": 1,
  "name": "Hard Ellipse",
  "category": "Basic",
  "doc": "A slanted hard ellipse, like a calligraphy pen.",
  "brush": {
    "falloff": "sharp",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.05,
    "pressureSize": false,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 45.0,
    "followStroke": false,
    "roundness": 0.4,
    "alpha": "",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
