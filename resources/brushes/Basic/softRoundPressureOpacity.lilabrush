{
  "format": "lilabrush",
  "version": 1,
  "name": "Soft Round, Pressure Opacity",
  "category": "Basic",
  "doc": "Pen pressure sets the opacity.",
  "brush": {
    "falloff": "smooth",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.08,
    "pressureSize": false,
    "pressureOpacity": true,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
