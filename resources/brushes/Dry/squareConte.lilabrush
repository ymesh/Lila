{
  "format": "lilabrush",
  "version": 1,
  "name": "Square Conte",
  "category": "Dry",
  "doc": "A square stick held at a fixed angle.",
  "brush": {
    "falloff": "smooth",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.05,
    "pressureSize": false,
    "pressureOpacity": true,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 20.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "alpha://lila/brush tips/pastel block.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
