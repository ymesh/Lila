{
  "format": "lilabrush",
  "version": 1,
  "name": "Flat Bristle Sweep",
  "category": "Artistic",
  "doc": "A wide flat bristle laying parallel streaks.",
  "brush": {
    "falloff": "smooth",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.03,
    "pressureSize": false,
    "pressureOpacity": true,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": true,
    "roundness": 1.0,
    "alpha": "alpha://lila/brush tips/bristle flat.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
