{
  "format": "lilabrush",
  "version": 1,
  "name": "Ink Line",
  "category": "Dynamic",
  "doc": "A smoothed tapering ink line.",
  "brush": {
    "falloff": "sharp",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.04,
    "pressureSize": true,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "",
    "strokeMode": "freehand",
    "lazyRadius": 10.0,
    "smoothing": 0.5,
    "pressureCurve": {
      "size": {
        "floor": 0.0,
        "exponent": 1.6
      }
    }
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
