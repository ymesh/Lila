{
  "format": "lilabrush",
  "version": 1,
  "name": "Clean Curve",
  "category": "Dynamic",
  "doc": "Draw freely; the line is smoothed on release.",
  "brush": {
    "falloff": "sharp",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.05,
    "pressureSize": false,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 0.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "",
    "strokeMode": "curve",
    "lazyRadius": 0.0,
    "smoothing": 0.0
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
