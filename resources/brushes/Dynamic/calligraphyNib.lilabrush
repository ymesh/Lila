{
  "format": "lilabrush",
  "version": 1,
  "name": "Calligraphy Nib",
  "category": "Dynamic",
  "doc": "A broad nib held at 45 degrees.",
  "brush": {
    "falloff": "smooth",
    "strength": 1.0,
    "flow": 1.0,
    "spacing": 0.03,
    "pressureSize": true,
    "pressureOpacity": false,
    "pressureFlow": false,
    "jitter": {
      "position": 0.0,
      "size": 0.0,
      "opacity": 0.0,
      "angle": 0.0
    },
    "angle": 45.0,
    "followStroke": false,
    "roundness": 1.0,
    "alpha": "alpha://lila/brush tips/ink nib.png",
    "strokeMode": "freehand",
    "lazyRadius": 0.0,
    "smoothing": 0.0,
    "pressureCurve": {
      "size": {
        "floor": 0.4,
        "exponent": 1.0
      }
    }
  },
  "payload": {
    "kind": "paint",
    "blend": "normal"
  }
}
