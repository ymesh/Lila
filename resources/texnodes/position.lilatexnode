{
  "format": "lilatexnode",
  "version": 1,
  "type": "position",
  "label": "Position",
  "category": "Input",
  "doc": "The surface position from the set's baked position map, in the bake's space: in cm once Bounds Min and Max hold the bake's bounds, 0 to 1 across them otherwise. (u, v, 0) when the set has no bake.",
  "inputs": [
    {
      "id": "boundsMin",
      "type": "vector",
      "default": [
        0,
        0,
        0
      ],
      "doc": "The bake's position map spans boundsMin to boundsMax, in cm. Adding the node fills both from the set's last bake, and they follow live mesh maps while those run."
    },
    {
      "id": "boundsMax",
      "type": "vector",
      "default": [
        1,
        1,
        1
      ],
      "doc": "The far corner of the position map's bounds."
    }
  ],
  "outputs": [
    {
      "id": "position",
      "type": "vector"
    }
  ],
  "params": [],
  "cost": 1,
  "externals": [
    "position"
  ],
  "body": {
    "position": "float3 lo = boundsMin.sample(uv);\nreturn lo + position.sample(uv).xyz * (boundsMax.sample(uv) - lo);"
  }
}
