{
  "format": "lilatexnode",
  "version": 1,
  "type": "mapping",
  "label": "Mapping",
  "category": "Transform",
  "doc": "Moves, rotates and scales texture coordinates. Feed it UV or Projection and link it into an Image's UV.",
  "inputs": [
    {
      "id": "coord",
      "type": "vector",
      "label": "UV",
      "implicit": "uv",
      "doc": "The coordinates to change: the mesh's uvs unless linked."
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "vector"
    }
  ],
  "params": [
    {
      "id": "offsetX",
      "type": "float",
      "default": 0.0,
      "softMin": -1,
      "softMax": 1
    },
    {
      "id": "offsetY",
      "type": "float",
      "default": 0.0,
      "softMin": -1,
      "softMax": 1
    },
    {
      "id": "rotation",
      "type": "float",
      "default": 0.0,
      "softMin": -180,
      "softMax": 180,
      "doc": "Degrees, around 0.5, 0.5."
    },
    {
      "id": "scaleX",
      "type": "float",
      "default": 1.0,
      "softMin": 0.1,
      "softMax": 8,
      "doc": "Repeats across."
    },
    {
      "id": "scaleY",
      "type": "float",
      "default": 1.0,
      "softMin": 0.1,
      "softMax": 8,
      "doc": "Repeats down."
    }
  ],
  "cost": 3,
  "body": {
    "out": "float2 c = coord.sample(uv).xy - 0.5;\nfloat a = radians(p.rotation);\nc = float2(c.x * cos(a) - c.y * sin(a), c.x * sin(a) + c.y * cos(a));\nreturn float3(c * float2(p.scaleX, p.scaleY) + 0.5 + float2(p.offsetX, p.offsetY), 0.0);"
  }
}
