{
  "format": "lilatexnode",
  "version": 1,
  "type": "curlNoise",
  "label": "Curl Noise",
  "category": "Noise",
  "doc": "A swirling flow field without sources or sinks, as a vector (x and y around 0): link it into Warp or Directional Warp for smoke, marble and brushed swirls.",
  "keywords": [
    "curl",
    "flow",
    "swirl",
    "vector noise",
    "divergence free"
  ],
  "inputs": [],
  "outputs": [
    {
      "id": "out",
      "type": "vector"
    },
    {
      "id": "color",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "scale",
      "type": "int",
      "default": 4,
      "min": 1,
      "softMax": 32,
      "doc": "Swirls across."
    },
    {
      "id": "octaves",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 8,
      "doc": "Detail levels."
    },
    {
      "id": "persistence",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "doc": "How much each finer level adds."
    },
    {
      "id": "seed",
      "type": "seed",
      "default": 0
    }
  ],
  "cost": 40,
  "helpers": [
    "noise"
  ],
  "body": {
    "out": "float2 e = float2(1.0 / 1024.0, 0.0);\nuint s = uint(p.seed);\nfloat dx = noiseFbm(uv + e.xy, p.scale, p.octaves, p.persistence, s, true) - noiseFbm(uv - e.xy, p.scale, p.octaves, p.persistence, s, true);\nfloat dy = noiseFbm(uv + e.yx, p.scale, p.octaves, p.persistence, s, true) - noiseFbm(uv - e.yx, p.scale, p.octaves, p.persistence, s, true);\nreturn float3(float2(dy, -dx) / (2.0 * e.x) / (8.0 * float(p.scale)), 0.0);",
    "color": "float2 e = float2(1.0 / 1024.0, 0.0);\nuint s = uint(p.seed);\nfloat dx = noiseFbm(uv + e.xy, p.scale, p.octaves, p.persistence, s, true) - noiseFbm(uv - e.xy, p.scale, p.octaves, p.persistence, s, true);\nfloat dy = noiseFbm(uv + e.yx, p.scale, p.octaves, p.persistence, s, true) - noiseFbm(uv - e.yx, p.scale, p.octaves, p.persistence, s, true);\nreturn float4(saturate(float2(dy, -dx) / (2.0 * e.x) / (8.0 * float(p.scale)) * 0.5 + 0.5), 0.5, 1.0);"
  }
}
