{
  "format": "lilatexnode",
  "version": 1,
  "type": "alphaTools",
  "label": "Alpha",
  "category": "Utility",
  "doc": "Edits a colour's alpha: multiply colour by it (premultiply) or divide it back out, take it from a mask, or show it as gray.",
  "keywords": [
    "premultiply",
    "unpremultiply",
    "alpha",
    "set alpha",
    "alpha merge"
  ],
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1.0
      ]
    },
    {
      "id": "alpha",
      "type": "gray",
      "default": 1.0,
      "doc": "The new alpha, for Set."
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    },
    {
      "id": "value",
      "type": "gray"
    }
  ],
  "params": [
    {
      "id": "operation",
      "type": "enum",
      "default": "set",
      "options": [
        "set",
        "premultiply",
        "unpremultiply"
      ],
      "doc": "set: alpha from the Alpha input. premultiply: colour times alpha. unpremultiply: colour divided by alpha."
    }
  ],
  "cost": 1,
  "body": {
    "out": "float4 c = input.sample(uv);\nif (p.operation == 1)\n    return float4(c.rgb * c.a, c.a);\nif (p.operation == 2)\n    return float4(c.a > 1e-5 ? c.rgb / c.a : float3(0.0), c.a);\nreturn float4(c.rgb, alpha.sample(uv));",
    "value": "return input.sample(uv).a;"
  }
}
