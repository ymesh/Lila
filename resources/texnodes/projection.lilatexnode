{
  "format": "lilatexnode",
  "version": 1,
  "type": "projection",
  "label": "Projection",
  "category": "Input",
  "doc": "Texture coordinates projected onto the mesh from the middle of its bake bounds instead of its uvs: flat, wrapped around a cylinder or around a sphere (an equirectangular map such as an earth texture). Link it into an Image's UV, through Mapping to move it.",
  "inputs": [
    {
      "id": "boundsMin",
      "type": "vector",
      "default": [
        0,
        0,
        0
      ],
      "doc": "The bake's position map spans boundsMin to boundsMax, in cm. Adding the node fills both from the set's last bake, and they follow live mesh maps while those run, so the projection sits on the mesh's middle."
    },
    {
      "id": "boundsMax",
      "type": "vector",
      "default": [
        1,
        1,
        1
      ],
      "doc": "The far corner of the position map's bounds."
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "vector"
    }
  ],
  "params": [
    {
      "id": "shape",
      "type": "enum",
      "default": "planar",
      "options": [
        "planar",
        "cylindrical",
        "spherical"
      ]
    },
    {
      "id": "axis",
      "type": "enum",
      "default": "y",
      "options": [
        "x",
        "y",
        "z"
      ],
      "doc": "Planar: the direction it projects along. Cylindrical and spherical: the pole."
    },
    {
      "id": "size",
      "type": "float",
      "default": 100.0,
      "min": 0.001,
      "softMax": 1000,
      "doc": "Planar and cylindrical: cm per repeat (height for cylindrical)."
    }
  ],
  "cost": 10,
  "externals": [
    "position"
  ],
  "body": {
    "out": "float3 lo = boundsMin.sample(uv);\nfloat3 hi = boundsMax.sample(uv);\n// About the middle of the bounds, so a mesh anywhere in the scene wraps around its own centre.\nfloat3 pos = (position.sample(uv).xyz - 0.5) * (hi - lo);\nfloat3 q = p.axis == 0 ? pos.zxy : p.axis == 1 ? pos : pos.xzy;\nfloat size = max(p.size, 1e-3);\nif (p.shape == 0)\n    return float3(q.x / size + 0.5, -q.z / size + 0.5, 0.0);\nfloat u = atan2(q.z, -q.x) * 0.15915494 + 0.5;\nif (p.shape == 1)\n    return float3(u, q.y / size + 0.5, 0.0);\nfloat r = max(length(q), 1e-6);\nreturn float3(u, asin(clamp(q.y / r, -1.0, 1.0)) * 0.31830989 + 0.5, 0.0);"
  }
}
