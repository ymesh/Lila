{
  "format": "lilatexnode",
  "version": 1,
  "type": "histogramShift",
  "label": "Histogram Shift",
  "category": "Filter",
  "doc": "Adds an amount to every value and wraps what passes 1 back round from 0, so the values cycle while their spread stays the same.",
  "keywords": [
    "offset",
    "wrap",
    "cycle",
    "shift values",
    "substance histogram shift"
  ],
  "inputs": [
    {
      "id": "input",
      "type": "gray",
      "default": 0.5
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "gray"
    }
  ],
  "params": [
    {
      "id": "position",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "doc": "How far to shift: 0 leaves the input, 1 wraps all the way round."
    }
  ],
  "cost": 1,
  "body": {
    "out": "float v = input.sample(uv) + p.position;\nreturn v > 1.0 ? v - 1.0 : v;"
  }
}
