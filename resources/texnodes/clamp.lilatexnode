{
  "format": "lilatexnode",
  "version": 1,
  "type": "clamp",
  "label": "Clamp",
  "category": "Filter",
  "doc": "Limits every colour channel to a range. Low and High each take a value or a link.",
  "keywords": [
    "limit",
    "saturate"
  ],
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1
      ]
    },
    {
      "id": "low",
      "type": "float",
      "default": 0.0
    },
    {
      "id": "high",
      "type": "float",
      "default": 1.0
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [],
  "cost": 1,
  "body": {
    "out": "float4 c = input.sample(uv);\nreturn float4(clamp(c.rgb, low.sample(uv), high.sample(uv)), c.a);"
  }
}
