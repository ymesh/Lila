      "id": "input",
      "type": "color",
      "default": [
        0,
        0,
        -1,
        -1
      ],
      "doc": "A Flood Fill output."
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "gray"
    }
  ],
  "params": [],
  "cost": 20
}
