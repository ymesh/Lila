{
  "format": "lilatexnode",
  "version": 1,
  "type": "transform",
  "label": "Transform",
  "category": "Transform",
  "doc": "Moves, rotates and scales the input around the texture's centre.",
  "inputs": [
    {
      "id": "input",
      "type": "color",
      "default": [
        0.5,
        0.5,
        0.5,
        1
      ]
    }
  ],
  "outputs": [
    {
      "id": "out",
      "type": "color"
    }
  ],
  "params": [
    {
      "id": "offsetX",
      "type": "float",
      "default": 0.0,
      "softMin": -1,
      "softMax": 1
    },
    {
      "id": "offsetY",
      "type": "float",
      "default": 0.0,
      "softMin": -1,
      "softMax": 1
    },
    {
      "id": "rotation",
      "type": "float",
      "default": 0.0,
      "softMin": -180,
      "softMax": 180,
      "doc": "Degrees."
    },
    {
      "id": "scale",
      "type": "float",
      "default": 1.0,
      "softMin": 0.1,
      "softMax": 4
    },
    {
      "id": "scaleX",
      "type": "float",
      "default": 1.0,
      "softMin": 0.1,
      "softMax": 4,
      "doc": "Width, times Scale."
    },
    {
      "id": "scaleY",
      "type": "float",
      "default": 1.0,
      "softMin": 0.1,
      "softMax": 4,
      "doc": "Height, times Scale."
    },
    {
      "id": "pivotX",
      "type": "float",
      "default": 0.0,
      "softMin": -0.5,
      "softMax": 0.5,
      "doc": "Where rotation and scale turn around, from the centre."
    },
    {
      "id": "pivotY",
      "type": "float",
      "default": 0.0,
      "softMin": -0.5,
      "softMax": 0.5,
      "doc": "Where rotation and scale turn around, from the centre."
    },
    {
      "id": "edges",
      "type": "enum",
      "default": "repeat",
      "options": [
        "repeat",
        "extend",
        "clip"
      ],
      "doc": "Past the input's edge. repeat: tiles it. extend: stretches its edge. clip: transparent black."
    }
  ],
  "cost": 3,
  "body": {
    "out": "float a = radians(-p.rotation);\nfloat2 pivot = 0.5 + float2(p.pivotX, p.pivotY);\nfloat2 c = uv - pivot - float2(p.offsetX, p.offsetY);\nfloat2 r = float2(c.x * cos(a) - c.y * sin(a), c.x * sin(a) + c.y * cos(a));\nfloat2 s = float2(p.scale * p.scaleX, p.scale * p.scaleY);\ns = float2(abs(s.x) > 1e-4 ? s.x : 1e-4, abs(s.y) > 1e-4 ? s.y : 1e-4);\nfloat2 q = r / s + pivot;\nif (p.edges == 2 && (any(q < 0.0) || any(q > 1.0)))\n    return float4(0.0, 0.0, 0.0, 0.0);\nreturn input.sample(p.edges == 1 ? clamp(q, texel() * 0.5, 1.0 - texel() * 0.5) : q);"
  }
}
