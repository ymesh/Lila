{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": "ON"
      }
    },
    {
      "name": "windows",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "toolset": { "value": "v143,host=x64,version=14.44", "strategy": "external" },
      "environment": {
        "VCPKG_KEEP_ENV_VARS": "LILA_PYTHON_DIR"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "Python_ROOT_DIR": "$env{LILA_PYTHON_DIR}"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "environment": {
        "VCPKG_KEEP_ENV_VARS": "LILA_PYTHON_DIR"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-gcc.cmake",
        "Python_ROOT_DIR": "$env{LILA_PYTHON_DIR}"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "dev", "configurePreset": "windows", "configuration": "RelWithDebInfo" },
    { "name": "release", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "windows", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
