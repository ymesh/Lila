# Precompiled headers and unity builds for every Lila target. Call lila_build_speed() once, after all targets exist.

find_program(LILA_SCCACHE sccache)
option(LILA_COMPILER_CACHE "Compile through sccache, shared by every build dir of a checkout" ON)
if(LILA_COMPILER_CACHE AND LILA_SCCACHE)
    set(_lila_cache ON)
else()
    set(_lila_cache OFF)
endif()

# sccache can't cache precompiled-header compiles, so with the cache on the PCH is skipped.
option(LILA_PCH "Precompile src/core/Pch.h when the compiler cache is off" ON)
option(LILA_UNITY_BUILD "Compile each target's sources in batches" ON)
set(LILA_UNITY_BATCH_SIZE 8 CACHE STRING "Sources per unity batch")

if(_lila_cache)
    # Cache keys are taken relative to the build dir, so every build dir of one checkout shares entries. The checkout stays
    # in the key: a hit replays the original compile's /showIncludes, and another checkout's header paths there leave
    # ninja blind to edits in this one, linking stale objects.
    # sccache applies basedirs per server, hence one server per build dir, on a port derived from its paths.
    string(SHA1 _lila_hash "${CMAKE_SOURCE_DIR}|${CMAKE_BINARY_DIR}")
    string(SUBSTRING ${_lila_hash} 0 4 _lila_hash)
    math(EXPR _lila_port "0x${_lila_hash} % 2000 + 42000")
    file(WRITE ${CMAKE_BINARY_DIR}/sccache.toml "basedirs = [\"${CMAKE_BINARY_DIR}/\"]\n")
    # LILA_CACHE_KEYS marks the key scheme, so a change to it recompiles everything and rewrites the header deps.
    set(_lila_launcher ${CMAKE_COMMAND} -E env SCCACHE_CONF=${CMAKE_BINARY_DIR}/sccache.toml LILA_CACHE_KEYS=checkout
        SCCACHE_SERVER_PORT=${_lila_port} --unset=SCCACHE_BASEDIRS --unset=SCCACHE_CLIENT_SIDE ${LILA_SCCACHE})
    set(CMAKE_C_COMPILER_LAUNCHER ${_lila_launcher})
    set(CMAKE_CXX_COMPILER_LAUNCHER ${_lila_launcher})
endif()

if(MSVC)
    # Debug info in the objects (/Z7), not a shared PDB: sccache can only cache those, and parallel compiles stop
    # queueing on mspdbsrv.
    set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>")

    find_program(LILA_LLD_LINK lld-link HINTS C:/Tools/llvm/bin "$ENV{ProgramFiles}/LLVM/bin")
    option(LILA_LLD "Link with lld-link when it is installed" ON)
    if(LILA_LLD AND LILA_LLD_LINK)
        set(CMAKE_LINKER_TYPE LLD)
        set(CMAKE_C_USING_LINKER_LLD ${LILA_LLD_LINK})
        set(CMAKE_CXX_USING_LINKER_LLD ${LILA_LLD_LINK})
    endif()
endif()

# Sources that clash with their batch neighbours (same-named file-local helpers, using-directives), relative to the
# source root. Renaming the clash takes a file off this list.
include(LilaUnitySkip)

function(_lila_build_speed_targets dir out)
    get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
    foreach(sub IN LISTS subdirs)
        _lila_build_speed_targets(${sub} sub_targets)
        list(APPEND targets ${sub_targets})
    endforeach()
    set(${out} ${targets} PARENT_SCOPE)
endfunction()

# Names of compile definitions whose value is a path into this checkout or build dir (or a target's output dir).
function(_lila_path_macros targets out)
    set(names "")
    foreach(target IN LISTS targets)
        foreach(property COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
            get_target_property(defs ${target} ${property})
            foreach(def IN LISTS defs)
                if(def MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
                    set(name ${CMAKE_MATCH_1})
                    string(FIND "${CMAKE_MATCH_2}" "${CMAKE_SOURCE_DIR}" in_source)
                    string(FIND "${CMAKE_MATCH_2}" "${CMAKE_BINARY_DIR}" in_binary)
                    string(FIND "${CMAKE_MATCH_2}" "$<TARGET_FILE" in_output)
                    if(NOT in_source EQUAL -1 OR NOT in_binary EQUAL -1 OR NOT in_output EQUAL -1)
                        list(APPEND names ${name})
                    endif()
                endif()
            endforeach()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES names)
    set(${out} ${names} PARENT_SCOPE)
endfunction()

function(lila_build_speed)
    if(LILA_PCH AND NOT _lila_cache)
        set(pch ON)
    else()
        set(pch OFF)
    endif()
    if(NOT pch AND NOT LILA_UNITY_BUILD AND NOT _lila_cache)
        return()
    endif()
    _lila_build_speed_targets(${CMAKE_SOURCE_DIR} targets)
    if(_lila_cache)
        _lila_path_macros("${targets}" path_macros)
        list(JOIN path_macros "|" path_regex)
        # The key hashes the preprocessed source, not the defines, so the salt has to be a token in the source.
        string(SHA1 salt "${CMAKE_SOURCE_DIR}|${CMAKE_BINARY_DIR}")
        set(salt_header ${CMAKE_BINARY_DIR}/generated/LilaCacheSalt.h)
        file(CONFIGURE OUTPUT ${salt_header} CONTENT "#pragma once\nnamespace lila_cache_salt_${salt} {}\n")
    endif()
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(NOT type MATCHES "^(OBJECT_LIBRARY|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|EXECUTABLE)$")
            continue()
        endif()
        get_target_property(dir ${target} SOURCE_DIR)
        if(dir MATCHES "/_deps/")
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        list(FILTER sources INCLUDE REGEX "\\.(cpp|cc|cxx)$")
        if(NOT sources)
            continue()
        endif()
        if(pch)
            target_precompile_headers(${target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:${CMAKE_SOURCE_DIR}/src/core/Pch.h>)
        endif()
        get_target_property(no_unity ${target} LILA_NO_UNITY)
        if(LILA_UNITY_BUILD AND NOT no_unity)
            set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE ${LILA_UNITY_BATCH_SIZE})
            if(MSVC)
                target_compile_options(${target} PRIVATE /bigobj)
            endif()
        endif()
        # A header beside the sources that bakes in a path (a test's loader in TestUtil.h) reaches every source including
        # it, and the scan below only reads sources: salt the whole target, unity batches included.
        set(salt_all OFF)
        if(path_regex)
            file(GLOB local_headers ${dir}/*.h)
            foreach(header IN LISTS local_headers)
                file(STRINGS ${header} uses REGEX "(^|[^A-Za-z0-9_])(${path_regex})([^A-Za-z0-9_]|$)" LIMIT_COUNT 1)
                if(uses)
                    set(salt_all ON)
                endif()
            endforeach()
        endif()
        if(salt_all)
            target_compile_options(${target} PRIVATE /FI${salt_header})
        endif()
        foreach(source IN LISTS sources)
            cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY ${dir} OUTPUT_VARIABLE path)
            if(NOT EXISTS ${path})
                continue()
            endif()
            # The cache keys ignore the build path, so a source that bakes a path in through a define would
            # hand another build dir its object with the wrong path. Salting it keeps its entries to this build dir.
            if(path_regex)
                file(STRINGS ${path} uses REGEX "(^|[^A-Za-z0-9_])(${path_regex})([^A-Za-z0-9_]|$)" LIMIT_COUNT 1)
                if(uses)
                    set_property(SOURCE ${path} TARGET_DIRECTORY ${target} APPEND PROPERTY COMPILE_OPTIONS /FI${salt_header})
                    set_source_files_properties(${path} TARGET_DIRECTORY ${target} PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
                endif()
            endif()
            if(NOT LILA_UNITY_BUILD)
                continue()
            endif()
            cmake_path(RELATIVE_PATH path BASE_DIRECTORY ${CMAKE_SOURCE_DIR} OUTPUT_VARIABLE relative)
            # A single-header library's implementation define does nothing once another source in the batch has
            # included that header.
            file(STRINGS ${path} defines REGEX "^#[ \t]*define[ \t]+[A-Z_]*IMPLEMENT")
            if(defines OR relative IN_LIST LILA_UNITY_SKIP)
                set_source_files_properties(${path} TARGET_DIRECTORY ${target} PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
            endif()
        endforeach()
    endforeach()
endfunction()
