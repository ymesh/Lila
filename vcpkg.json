{
  "name": "lila",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "network",
        "png",
        "jpeg",
        "freetype",
        "harfbuzz",
        "doubleconversion",
        "pcre2",
        "thread",
        "zstd",
        "future",
        "opengl",
        "sessionmanager",
        "dnslookup",
        "openssl",
        "sql",
        "sql-sqlite",
        { "name": "xcb", "platform": "linux" },
        { "name": "fontconfig", "platform": "linux" }
      ]
    },
    "qtsvg",
    {
      "name": "qttools",
      "default-features": false
    },
    "tbb",
    "alembic",
    "glm",
    "nlohmann-json",
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "cpp-httplib",
    "doctest",
    "gtest",
    "shader-slang",
    "eigen3",
    "zstd",
    "manifold",
    "meshoptimizer",
    "joltphysics",
    "miniz",
    "libwebp",
    "zlib",
    "draco",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "miniaudio",
    {
      "name": "tracy",
      "default-features": false,
      "features": [
        "on-demand",
        "cli-tools"
      ]
    }
  ],
  "default-features": [
    "usd",
    "volumes"
  ],
  "features": {
    "usd": {
      "description": "OpenUSD: USD files, live stages, MaterialX and Hydra viewport renderers (the OpenUSD extension)",
      "dependencies": [
        {
          "name": "usd",
          "features": [
            "imaging",
            "embree",
            "materialx",
            "python",
            "vulkan"
          ]
        }
      ]
    },
    "volumes": {
      "description": "OpenVDB: .vdb and .nvdb volumes (the NanoVDB extension)",
      "dependencies": [
        "openvdb"
      ]
    }
  },
  "builtin-baseline": "6f6324d69cc4d5229804bee9f72737fe2ef08087",
  "vcpkg-configuration": {
    "overlay-ports": [
      "./vcpkg-ports"
    ]
  }
}
