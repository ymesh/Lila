def curve(points: Sequence[Any] | None = None, type: str | None = None, degree: int | None = None, closed: bool | None = None, editPoints: bool | None = None, knots: Sequence[Any] | None = None, weights: Sequence[Any] | None = None, handleL: Sequence[Any] | None = None, handleR: Sequence[Any] | None = None, handleType: str | None = None, tilt: Sequence[Any] | None = None, radius: Sequence[Any] | None = None, cornerRadius: Sequence[Any] | None = None, name: str | None = None, splines: Sequence[Any] | None = None, *, p: Sequence[Any] | None = None, t: str | None = None, d: int | None = None, c: bool | None = None, ep: bool | None = None, k: Sequence[Any] | None = None, w: Sequence[Any] | None = None, ht: str | None = None, n: str | None = None) -> Any:
    """Create a curve: poly, Bezier or NURBS. Returns its name.

    Args:
        points: [[x, y, z], ...] cm: poly vertices, Bezier anchors, NURBS control points (or edit points with editPoints). Short form p.
        type: Spline kind. Short form t. One of 'poly', 'bezier', 'nurbs'. Default 'nurbs'.
        degree: NURBS degree (1 to 7). Short form d. Default 3.
        closed: A closed loop (periodic for NURBS). Short form c. Default False.
        editPoints: NURBS: the points are edit points the curve passes through. Short form ep. Default False.
        knots: NURBS knots: points + degree + 1 values, or points + 1 breakpoints when closed. Short form k.
        weights: NURBS weights, one per point. Short form w.
        handleL: Bezier incoming handles, one per anchor.
        handleR: Bezier outgoing handles, one per anchor.
        handleType: Bezier handle type for every anchor. Short form ht. One of 'auto', 'vector', 'aligned', 'free'.
        tilt: Twist per point, radians.
        radius: Sweep scale per point.
        cornerRadius: Fillet radius per point, cm.
        name: Name; made unique. Short form n.
        splines: Whole splines as curveData returns them, instead of points and the flags above.
    """

def curveBoolean(*objects: Any, operation: str | None = None, normal: Sequence[float] | None = None, tolerance: float | None = None, constructionHistory: bool | None = None, hideInputs: bool | None = None, name: str | None = None, ch: bool | None = None, n: str | None = None) -> Any:
    """2D boolean of closed planar curves into a new curve with live history (C4D's Spline Mask, Rhino's CurveBoolean): union, subtract (the rest from the first), intersect or xor. Each curve's loops fill even-odd, so a letter's counter stays a hole. Pieces are cut exactly from the inputs, with sharp corners where they cross. Returns [curve, curveBoolean].

    Args:
        objects: target tools...
        operation: union joins every input, subtract cuts the others out of the first, intersect keeps what all share, xor what an odd number cover. One of 'union', 'subtract', 'intersect', 'xor'. Default 'union'.
        normal: Plane normal; zero fits the plane to the curves. Default [0.0, 0.0, 0.0].
        tolerance: Where the cuts fall: chord error of the clip, cm. The pieces are cut from the input curves. Default 0.002.
        constructionHistory: Keep the history node so its settings stay live. Short form ch. Default True.
        hideInputs: Hide the input curves (they still drive the result). Default False.
        name: Name of the result curve; made unique. Short form n.
    """

def curveCenterLine(*objects: Any, normal: Sequence[float] | None = None, tolerance: float | None = None, constructionHistory: bool | None = None, name: str | None = None, ch: bool | None = None, n: str | None = None) -> Any:
    """Centre lines (the medial axis of the straight skeleton) of the region closed planar curves bound, as poly curves with live history. Returns [curve, curveCenterLine].

    Args:
        objects: curves.
        normal: Plane normal; zero fits the plane to the curves. Default [0.0, 0.0, 0.0].
        tolerance: Tessellation of curved input, cm. Default 0.01.
        constructionHistory: Keep the history node so its settings stay live. Short form ch. Default True.
        name: Name of the result curve; made unique. Short form n.
    """

def curveControls(*objects: Any, count: int | None = None, handles: bool | None = None, mirror: bool | None = None, mirrorAxis: str | None = None, size: float | None = None, name: str | None = None, c: int | None = None, hd: bool | None = None, m: bool | None = None, ma: str | None = None, s: float | None = None, n: str | None = None) -> Any:
    """Build controls that drive a curve's points: a locator per control point (in an offset group, under a <curve>_controls group beside the curve), optionally tangent handle controls under each Bezier point. The curve follows them live. Returns the controls.

    Args:
        objects: curves (default: the selected curves).
        count: Controls per spline: 0 for one per existing point, else the curve is respaced to this many points first. Short form c. Default 0.
        handles: Bezier curves: a control for each tangent handle, under its point's control. Short form hd. Default False.
        mirror: Name mirrored pairs of controls _l and _r so pose mirroring swaps them. Short form m. Default False.
        mirrorAxis: The axis the mirror plane faces. Short form ma. One of 'x', 'y', 'z'. Default 'x'.
        size: Control draw size, cm; 0 sizes them to the curve. Short form s. Default 0.0.
        name: Name prefix for the controls; default the curve's name. Short form n.

    Examples:
        curveControls("Spine", handles=True)

        curveControls("Lip", count=7, mirror=True)
    """

