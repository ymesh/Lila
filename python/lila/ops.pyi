        save: Save the imported packages in Unreal afterwards. Short form sv.
        file: File to import; or pass it positionally. Short form f.
        wait: Block until Unreal finishes and return its reply. Short form w. Default False.
    """

def unrealListPlacements(*objects: Any) -> Any:
