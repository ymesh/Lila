        falloff: Triangles within this many times the nearest distance count; higher is smoother. Default 2.0.
        collisionShape: off | sphere | capsule | box. One of 'off', 'sphere', 'capsule', 'box'. Default 'box'.
        params: {param: value} for any other attribute.
        name: Name for the deformer.

    Examples:
        rigidBind('Scales', 'Arm', params={'collisionLift': 1.0, 'thickness': 0.05})
    """

def rigidBindToSkin(*objects: Any, maxInfluences: int | None = None) -> Any:
    """Turn a rigid bind into skin weights for games: every point of a piece takes the driver's skin weights where the piece sits, so each piece moves with the driver's joints as one rigid-looking part, with no extra joints and no bake. Relaxation and collision are dropped. The driver must be skinned; the rigid bind is replaced by a skinCluster bound like the driver's. Returns the skinClusters.

    Args:
        objects: rigid binds or meshes (default the selection).
        maxInfluences: Joints per piece. Default 4.

    Examples:
        rigidBindToSkin('Scales', maxInfluences=4)
    """

def rigidify(*objects: Any, regions: str | None = None, sets: Sequence[Any] | None = None, blendRings: int | None = None, name: str | None = None) -> Any:
    """Add a rigidify deformer: regions of the meshes keep their rest shape and move rigidly with the deformation under them. Regions are the meshes' islands, the selected components (each connected patch one region), sets, or the painted weights. Returns the deformers.

    Args:
        objects: meshes.
        regions: islands | selection | sets | weights. One of 'islands', 'selection', 'sets', 'weights'. Default 'islands'.
        sets: regions=sets: the sets, each one region.
        blendRings: Edge rings easing from rigid into the deformation. Default 2.
        name: Name for the deformer.
    """

def roof(*objects: Any, pitch: float | None = None, height: float | None = None, overhang: float | None = None, gableEdges: str | None = None, gableEnds: bool | None = None, thickness: float | None = None, uvScale: float | None = None, normal: Sequence[float] | None = None, tolerance: float | None = None, constructionHistory: bool | None = None, name: str | None = None, ch: bool | None = None, n: str | None = None) -> Any:
    """Build a roof over closed footprint curves with live history (Houdini's straight skeleton roof): a plane per footprint edge at the pitch (or reaching the given ridge height), hips and valleys between them, ridges where they meet, gables on the edges asked for, an overhang and a slab thickness. Returns [mesh, roof].

    Args:
        objects: footprints.
        pitch: Slope of the roof planes, degrees. Default 30.0.
        height: Ridge height above the footprint, cm; 0 uses the pitch. Default 0.0.
        overhang: How far the eaves reach past the footprint, cm. Default 0.0.
        gableEdges: Footprint edges that end in a gable, e.g. "0 2" (edge i runs from point i to i + 1).
        gableEnds: Gable every end: each edge between two convex corners shorter than both neighbours. Default False.
        thickness: Roof slab thickness, cm; 0 is a single surface. Default 0.0.
        uvScale: cm per UV unit along the roof planes. Default 100.0.
        normal: Up for the roof; zero fits the plane to the footprint. Default [0.0, 0.0, 0.0].
        tolerance: Tessellation of curved footprints, cm. Default 0.01.
        constructionHistory: Keep the history node so its settings stay live. Short form ch. Default True.
        name: Mesh name; made unique. Short form n.
    """

def rotate(*objects: Any, by: Sequence[float] | None = None, to: Sequence[float] | None = None, x: float | None = None, y: float | None = None, z: float | None = None, space: str | None = None) -> Any:
    """Rotate objects about their pivots. rotate(by=(x, y, z)) adds a rotation (degrees, XYZ order) in `space`; rotate(to=(x, y, z)) sets the local Euler angles.

    rotate(x=90) sets one local angle and leaves the others. With components selected it turns them that far about the world axis through their centre instead.

    Args:
        objects: objects.
        by: Relative rotation, degrees.
        to: Absolute local rotation, degrees.
        x: Local X rotation, degrees; on components, a turn about world X.
        y: Local Y rotation, degrees.
        z: Local Z rotation, degrees.
        space: 'world', 'object' or 'parent' for `by`, or 'gimbal' to add `by` to the rotate channels. Default 'world'.
    """

def rotateComponents(by: Sequence[float] | None = None, pivot: Sequence[float] | None = None) -> Any:
    """Rotate the selected components about a world pivot (default: their centre; with symmetry, a pair clear of the mirror plane turns about each side's own centre). Degrees, XYZ order.

    Args:
        by: Rotation, degrees.
        pivot: World pivot.
    """

def sampleField(*objects: Any) -> Any:
