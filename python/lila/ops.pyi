def settleSkinWeights(*objects: Any, target: str | None = None, start: int | None = None, end: int | None = None, step: int | None = None, strength: float | None = None, regularize: float | None = None, smoothIterations: int | None = None, simIterations: int | None = None, contact: bool | None = None, vertices: Sequence[Any] | None = None, t: str | None = None, s: int | None = None, e: int | None = None, by: int | None = None, st: float | None = None, rg: float | None = None, si: int | None = None, ni: int | None = None, ct: bool | None = None, v: Sequence[Any] | None = None) -> Any:
