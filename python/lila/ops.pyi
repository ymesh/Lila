    Args:
        objects: files (optional).
        description: Change description / commit message.
        changelist: Perforce changelist number; default changelist when omitted.
        path: Directory that picks the provider when no files are given. Default: the workspace root.
    """

def scSync(*objects: Any, path: str | None = None) -> Any:
    """Get latest. No files = the whole workspace (git: pull --ff-only).

    Args:
        objects: files (optional).
        path: Directory that picks the provider when no files are given. Default: the workspace root.
    """

def scale(*objects: Any, by: Sequence[float] | None = None, to: Sequence[float] | None = None, x: float | None = None, y: float | None = None, z: float | None = None) -> Any:
    """Scale objects along their own axes. scale(by=(x, y, z)) multiplies; scale(to=(x, y, z)) sets.

    scale(x=2) sets one local scale and leaves the others. With components selected it scales them by that factor along the world axis about their centre instead, so scale(y=0) flattens them.

    Args:
        objects: objects.
        by: Factor per axis.
        to: Absolute scale.
        x: Local X scale; on components, a factor along world X.
        y: Local Y scale.
        z: Local Z scale.
    """

def scaleComponents(by: Sequence[float] | None = None, pivot: Sequence[float] | None = None, orient: Sequence[float] | None = None) -> Any:
    """Scale the selected components about a world pivot (default: their centre; with symmetry, a pair clear of the mirror plane scales about each side's own centre).

    Args:
        by: Factor per axis: the world axes, or the axes orient= turns them to.
        pivot: World pivot.
        orient: Rotation of the scale axes from the world axes, degrees, XYZ order.
    """

def scaleCurvature(*objects: Any, factor: float | None = None, f: float | None = None) -> Any:
    """Multiply curves' curvature: below 1 flattens them toward a straight line, 0 straightens them, above 1 bends them tighter. Lengths along the curve and its start stay. In vertex mode only the selected points move. Returns the curves.

    Args:
        objects: curves.
        factor: Curvature multiplier. Short form f. Default 0.5.
    """

