def savePose(*objects: Any, tier: str | None = None, character: str | None = None, nodes: Sequence[Any] | None = None, hierarchy: bool | None = None, channels: Sequence[Any] | None = None, tags: Sequence[Any] | None = None, thumbnail: bool | None = None, ti: str | None = None, ch: str | None = None, n: Sequence[Any] | None = None, hi: bool | None = None, c: Sequence[Any] | None = None, tg: Sequence[Any] | None = None, th: bool | None = None) -> Any:
    """Store the current pose of the selected nodes (and everything under them) in the pose library, keyed by node name without namespace, rotations as quaternions. The character is the selection's root joint (or the given one). bind, ref and test are each character's reserved poses. Returns the pose's summary.

