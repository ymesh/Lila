def xform(*objects: Any, query: bool | None = None, worldSpace: bool | None = None, translation: Any | None = None, rotation: Any | None = None, scale: Any | None = None, matrix: Any | None = None, q: bool | None = None, ws: bool | None = None, t: Any | None = None, ro: Any | None = None, s: Any | None = None, m: Any | None = None) -> Any:
    """Query or set the transform of objects, in local or world space.

    Sets every flag given on each object, or with query=True returns one value of the first object: pass the flag to read as True. Values are local to the parent unless worldSpace is on.

    Args:
        objects: Transforms to edit or query; the selection when none are given.
        query: Return a value of the first object instead of setting. Pick it by passing one of translation, rotation, scale or matrix as True. Short form q. Default False. Example: `xform("cube1", query=True, translation=True)`
        worldSpace: Read and write in world space instead of relative to the parent. Rotation and scale queries stay local. Short form ws. Default False. Example: `xform("cube1", worldSpace=True, translation=(0, 2, 0))`
        translation: Position as (x, y, z) to set, or True to read it with query. Short form t. Example: `xform("cube1", translation=(1, 0, 0))`
        rotation: Euler rotation in degrees as (x, y, z) to set, or True to read it with query. Short form ro. Example: `xform("cube1", rotation=(0, 45, 0))`
        scale: Scale as (x, y, z) to set, or True to read it with query. Short form s. Example: `xform("cube1", scale=(2, 2, 2))`
        matrix: The whole transform as 16 floats, column-major, to set; or True to read it with query. Short form m. Example: `xform("cube1", query=True, worldSpace=True, matrix=True)`

    Examples:
        xform("cube1", translation=(0, 1, 0), rotation=(0, 90, 0))

        pos = xform("cube1", query=True, worldSpace=True, translation=True)
    """

