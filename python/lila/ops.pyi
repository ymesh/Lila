def unrealExpressionRig(*objects: Any, skeletalMesh: str | None = None, rig: str | None = None, postProcess: bool | None = None, morphShapes: bool | None = None, dryRun: bool | None = None, sm: str | None = None, r: str | None = None, pp: bool | None = None, dry: bool | None = None) -> Any:
