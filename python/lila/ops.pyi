def bakeBendBones(*objects: Any, segments: int | None = None, start: int | None = None, end: int | None = None, step: int | None = None, poses: int | None = None, angle: float | None = None, seed: int | None = None, maxInfluences: int | None = None, iterations: int | None = None, tolerance: float | None = None, sg: int | None = None, mi: int | None = None) -> Any:
