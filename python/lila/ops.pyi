def createWeightProxy(*objects: Any, loopsPerBone: int | None = None, edgesAround: int | None = None, resolution: int | None = None, joints: Sequence[Any] | None = None, name: str | None = None, lpb: int | None = None, ea: int | None = None, res: int | None = None, j: Sequence[Any] | None = None, n: str | None = None) -> Any:
