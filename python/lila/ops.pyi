def stitch(*objects: Any, pattern: str | None = None, stitchLength: float | None = None, stitchGap: float | None = None, rotation: float | None = None, stitchWidth: float | None = None, rows: int | None = None, rowSpacing: float | None = None, rowAlign: str | None = None, offset: float | None = None, diameter: float | None = None, flatten: float | None = None, plies: int | None = None, twist: float | None = None, restHeight: float | None = None, insetDepth: float | None = None, jitter: float | None = None, seed: int | None = None, continuousUv: bool | None = None, uvScale: float | None = None, uvRandom: float | None = None, sides: int | None = None, segments: int | None = None, up: Sequence[float] | None = None, preset: str | None = None, surfaces: Sequence[Any] | None = None, constructionHistory: bool | None = None, name: str | None = None, srf: Sequence[Any] | None = None, ch: bool | None = None, n: str | None = None) -> Any:
