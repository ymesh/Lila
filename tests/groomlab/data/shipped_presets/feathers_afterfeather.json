    {"name": "afterfeatherFeather/barbules", "type": "Propagate", "params": {"sides": "both", "count": 10, "start": 0.1, "segments": 2, "length": 0.025, "lengthProfile": [[0, 1], [1, 0.5]], "angle": 30.0, "curl": 0.0, "droop": 0.0, "lengthRandom": 0.6, "angleRandom": 25.0, "keepShaft": true}, "ui": {"x": 1320, "y": 600}},
    {"name": "afterfeatherFeather/fluffColor", "type": "HairColor", "params": {"melanin": 0.12, "redness": 0.15, "dye": [0.9, 0.85, 0.6], "tipColor": [0.35, 0.45, 0.12], "melaninRandom": 0.08, "tipStrength": 0.6, "specular": 0.15, "roughness": 0.7}, "ui": {"x": 1360, "y": 640}},
