    {"name": "afterfeatherFeather/vaneBaseColor", "type": "HairColor", "params": {"melanin": 0.12, "redness": 0.15, "dye": [0.75, 0.72, 0.5], "melaninRandom": 0.08}, "ui": {"x": 1080, "y": 360}},
