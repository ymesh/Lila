    {"name": "afterfeatherFeather/ruffleMask", "type": "Expression", "params": {"expression": "# the vane's ruffle: full where it meets the fluff, a fifth of it up top\n(1 - smoothstep($shaftU, 0.2, 0.5)) * (1 - $isShaft)", "min": 0.2, "max": 1.0}, "ui": {"x": 760, "y": 40}},
    {"name": "afterfeatherFeather/vane", "type": "Propagate", "params": {"shaftWidth": 0.012, "sides": "both", "count": 40, "start": 0.2, "segments": 10, "length": 0.22, "lengthProfile": [[0, 0.3], [0.2, 0.8], [0.5, 1], [0.9, 0.7], [1, 0.35]], "angle": 50.0, "angleProfile": [[0, 1.1], [0.7, 0.9], [1, 0.45]], "curl": 16.0, "droop": 8.0, "splits": 3.0, "splitAmount": 0.5, "lengthRandom": 0.06, "angleRandom": 2.5}, "ui": {"x": 840, "y": 120}},
