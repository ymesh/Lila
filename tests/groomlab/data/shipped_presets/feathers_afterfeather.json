    {"name": "afterfeatherFeather/colorMix", "type": "Expression", "params": {"expression": "# which barbs take the base's pale color: all at the base, none up the vane, speckled between\n$m = 1 - smoothstep($shaftU, 0.2, 0.5);\nclamp($m + ($rand - 0.5) * 0.6, 0, 1)", "min": 0.0, "max": 1.0}, "ui": {"x": 960, "y": 240}},
    {"name": "afterfeatherFeather/vaneSplit", "type": "Split", "params": {"mode": "map", "weightA": 1.0, "weightB": 1.0, "select": 1.0}, "paramInputs": ["select"], "ui": {"x": 1000, "y": 280}},
